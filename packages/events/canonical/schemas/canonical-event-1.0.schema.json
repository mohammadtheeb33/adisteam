          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]{0,254}[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Source Name",
          "type": "string"
        },
        "source_type": {
          "description": "Kind of telemetry source (e.g. auditd, windows_eventlog, zeek, agent).",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Type",
          "type": "string"
        },
        "src_ip": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "format": "ipv6",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source address.",
          "title": "Src Ip"
        },
        "src_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source port (TCP/UDP/SCTP).",
          "title": "Src Port"
        },
        "timestamp": {
          "description": "When the event occurred at the source (UTC).",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "trace_id": {
          "description": "W3C trace id; inherited from the current context when omitted.",
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "event_type",
        "timestamp",
        "source_type",
        "source_name"
      ],
      "title": "SecurityEvent",
      "type": "object"
    },
    "SeverityHint": {
      "description": "Severity reported or implied by the source. ADIS computes its own threat score.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "SeverityHint",
      "type": "string"
    },
    "SystemEvent": {
      "additionalProperties": false,
      "description": "Host and operating-system activity (boot, services, configuration, accounts).",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+=-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ADIS identifier of the collecting agent, if any.",
          "title": "Agent Id"
        },
        "category": {
          "const": "system",
          "default": "system",
          "description": "Event category (schema discriminator).",
          "title": "Category",
          "type": "string"
        },
        "event_id": {
          "description": "Unique id; used to deduplicate.",
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "description": "Dotted lower-case type, prefixed by the category (e.g. process.started).",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Event Type",
          "type": "string"
        },
        "host_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+=-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ADIS identifier of the host the event concerns.",
          "title": "Host Id"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Vendor-specific data: JSON only, bounded, credentials redacted.",
          "title": "Metadata",
          "type": "object"
        },
        "received_at": {
          "description": "When ADIS received the event (UTC).",
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "description": "Canonical schema version (MAJOR.MINOR).",
          "title": "Schema Version",
          "type": "string"
        },
        "severity_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeverityHint"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Severity reported by the source; not the ADIS score."
        },
        "source_name": {
          "description": "Configured name of the source instance (e.g. zeek@sensor-1).",
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]{0,254}[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Source Name",
          "type": "string"
        },
        "source_type": {
          "description": "Kind of telemetry source (e.g. auditd, windows_eventlog, zeek, agent).",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Type",
          "type": "string"
        },
        "timestamp": {
          "description": "When the event occurred at the source (UTC).",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "trace_id": {
          "description": "W3C trace id; inherited from the current context when omitted.",
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "event_type",
        "timestamp",
        "source_type",
        "source_name"
      ],
      "title": "SystemEvent",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "authentication": "#/$defs/AuthenticationEvent",
      "network": "#/$defs/NetworkFlowEvent",
      "process": "#/$defs/ProcessEvent",
      "security": "#/$defs/SecurityEvent",
      "system": "#/$defs/SystemEvent"
    },
    "propertyName": "category"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SystemEvent"
    },
    {
      "$ref": "#/$defs/AuthenticationEvent"
    },
    {
      "$ref": "#/$defs/NetworkFlowEvent"
    },
    {
      "$ref": "#/$defs/ProcessEvent"
    },
    {
      "$ref": "#/$defs/SecurityEvent"
    }
  ],
  "title": "ADIS canonical event 1.0"
}
